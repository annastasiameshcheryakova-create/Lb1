def save_score(score):
    try:
        total = int(open("score.txt").read())
    except:
        total = 0
    with open("score.txt", "w") as f:
        f.write(str(total + score))

def load_score():
    try:
        return int(open("score.txt").read())
    except:
        return 0

def restart(x, y):
    turtle.bye()
    os.system(f'python "{__file__}"')

turtle.onscreenclick(restart)
turtle.done()
