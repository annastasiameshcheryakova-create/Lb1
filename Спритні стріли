import turtle
import random
import os

window = turtle.Screen()
window.setup(width=900, height=700)
window.bgcolor("lightblue")
window.title("спритна стріла")

t = turtle.Turtle()
t.speed(5)
t.penup()
t.goto(-380, 200)

for i in range(15):
    t.write(str(i + 1), align="center", font=("Arial", 14, "normal"))
    t.right(90)
    for j in range(10):
        t.penup()
        t.forward(20)
        t.pendown()
        t.forward(20)
    t.penup()
    t.backward(400)
    t.left(90)
    t.forward(60)

finish = turtle.Turtle()
finish.hideturtle()
finish.speed(0)
finish.penup()
finish.goto(340, 250)
finish.right(90)
finish.pendown()
finish.forward(500)

bet = window.textinput("Зроби ставку", "На яку стрілу ти ставиш? (1, 2, 3 або 4):")
while bet not in ["1", "2", "3", "4"]:
    bet = window.textinput("Помилка!", "Введи число 1, 2, 3 або 4:")

player_1 = turtle.Turtle()
player_1.shape("arrow")
player_1.color("brown")
player_1.penup()
player_1.goto(-380, 120)
for i in range(10):
    player_1.right(36)

player_2 = turtle.Turtle()
player_2.shape("arrow")
player_2.penup()
player_2.color("brown")
player_2.goto(-380, 20)
for i in range(15):
    player_2.right(24)

player_3 = turtle.Turtle()
player_3.shape("arrow")
player_3.color("brown")
player_3.penup()
player_3.goto(-380, -80)
for i in range(20):
    player_3.right(18)

player_4 = turtle.Turtle()
player_4.shape("arrow")
player_4.color("brown")
player_4.penup()
player_4.goto(-380, -180)
for i in range(25):
    player_4.right(14)


x1 = player_1.xcor()
x2 = player_2.xcor()
x3 = player_3.xcor()
x4 = player_4.xcor()

while x1 < 340 and x2 < 340 and x3 < 340 and x4 < 340:
    player_1.forward(random.randint(5, 10))
    player_2.forward(random.randint(5, 10))
    player_3.forward(random.randint(5, 10))
    player_4.forward(random.randint(5, 10))
    x1 = player_1.xcor()
    x2 = player_2.xcor()
    x3 = player_3.xcor()
    x4 = player_4.xcor()

message = turtle.Turtle()
message.hideturtle()
message.penup()
message.goto(0, -250)
message.color("black")

winner = None
if x1 >= 340:
    message.write("Перемогла ПЕРША стріла!", align="center", font=("Arial", 20, "bold"))
elif x2 >= 340:
    message.write("Перемогла ДРУГА стріла!", align="center", font=("Arial", 20, "bold"))
elif x3 >= 340:
    message.write("Перемогла ТРЕТЯ стріла!", align="center", font=("Arial", 20, "bold"))
elif x4 >= 340:
    message.write("Перемогла ЧЕТВЕРТА стріла!", align="center", font=("Arial", 20, "bold"))

message = turtle.Turtle()
message.hideturtle()
message.penup()
message.goto(0, -290)
message.color("red")

if bet == winner:
     message.write("Вітаємо! Ви ВИГРАЛИ ставку!", align="center", font=("Arial", 20, "bold"))
else:
    message.write("На жаль, ви ПРОГРАЛИ ставку.", align="center", font=("Arial", 20, "bold"))

